# --- Server -----------------------------------------------------------------
PORT=3000
# Where clients reach this server. The MCP endpoint is PUBLIC_URL/mcp, and that
# URL is the audience tokens must be issued for.
PUBLIC_URL=http://localhost:3000
# Browser origins allowed to call /mcp, comma-separated. Desktop and CLI clients
# send no Origin and are always allowed.
ALLOWED_ORIGINS=

# --- Storage ----------------------------------------------------------------
# API keys and the audit log. Migrations run on startup.
DATABASE_URL=postgres://mcp:mcp@localhost:5442/mcp
# Rate limit counters, shared across replicas. Without it they are kept in memory.
REDIS_URL=redis://localhost:6390

# --- Sign-in with your identity provider (optional) -------------------------
# Leave OIDC_ISSUER empty to accept API keys only. See docs/authentication.md.
OIDC_ISSUER=
# Defaults to PUBLIC_URL/mcp. Set it if your provider cannot issue that audience.
OIDC_AUDIENCE=
# Skips discovery. Only needed when the discovery document is not reachable.
OIDC_JWKS_URL=

# --- Limits -----------------------------------------------------------------
# Calls one caller may make to one tool per window.
RATE_LIMIT_PER_WINDOW=60
RATE_LIMIT_WINDOW=1 minute
TOOL_TIMEOUT=10 seconds

# --- The example CRM --------------------------------------------------------
# Leave CRM_BASE_URL empty to use the in-memory demo CRM.
CRM_BASE_URL=
CRM_API_TOKEN=

# --- Tracing (optional) -----------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_AUTHORIZATION=
OTEL_SERVICE_NAME=mcp-server
